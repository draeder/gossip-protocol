{
  "name": "gossip-protocol",
  "version": "1.0.0",
  "description": "Gossip-style message propagation over a WebRTC partial mesh (PartialMesh) with FreeRTC signaling",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "build:browser": "tsup --config tsup.browser.config.ts",
    "dev": "cd examples/vue3 && npm run dev --",
    "prepublishOnly": "npm run build",
    "example:basic": "cd examples/basic && npm run dev",
    "example:vue3": "cd examples/vue3 && npm run dev",
    "test": "node scripts/run-e2e-loop.mjs"
  },
  "keywords": [
    "webrtc",
    "p2p",
    "peer-to-peer",
    "mesh",
    "networking",
    "partial-mesh",
    "signaling",
    "auto-discovery",
    "freertc"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/draeder/gossip-protocol.git"
  },
  "dependencies": {
    "freertc": "github:draeder/freertc",
    "unsea": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@playwright/test": "^1.55.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
